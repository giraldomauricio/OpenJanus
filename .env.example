# Only configure the providers you want to use.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_NUM_CTX=16384

# AGENT_DATA_DIR=./data

# Logging and caching (all optional)
# OPENJANUS_LOG_LEVEL=INFO       # DEBUG also logs tool arguments (truncated)
# OPENJANUS_LOG_FILE=1           # 0 = console only (default file: data/logs/openjanus.log)
# OPENJANUS_PROMPT_CACHE=1       # 0 = stop sending the Claude cache marker
